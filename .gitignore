# Game data never goes in the repo
rom/
*.smd
*.bin
*.gen
*.srm

# Build output and generated code
build/
__pycache__/
*.pyc

# Music references (game audio, never committed)
vgm/
mp3/

# Third-party SDKs (fetched, see README)
third_party/

# Per-user files the game writes
psiv.ini
psiv.log
psiv-crash.txt
saves/
screenshots/

# Sound effect samples (your own; licensed, never committed)
sfx/**/*.wav

# Character art for the side panels (game art, never committed)
characters/
# converted portraits (game art, never committed)
portraits/

# Save files you collect for testing (third-party saves, never committed)
imported saves/

# Your own collections for soundtrack ideas (other games' ROMs: never committed)
custom soundtrack ideas/
*.smc
*.sfc
